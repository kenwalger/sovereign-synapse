# EditorConfig helps developers define and maintain consistent 
# coding styles between different editors and IDEs.
# http://editorconfig.org

root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.{json,yaml,yml}]
indent_size = 2

[Makefile]
indent_style = tab